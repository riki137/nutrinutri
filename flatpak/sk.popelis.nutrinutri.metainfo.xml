<component type="desktop-application">
  <id>sk.popelis.nutrinutri</id>

  <name>NutriNutri</name>
  <summary>Your personal AI nutritionist</summary>

  <developer id="sk.popelis">
    <name>riki137</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <categories>
    <category>Utility</category>
  </categories>

  <description>
    <p>
      NutriNutri makes nutrition tracking effortless. Photograph your meal, or
      just describe it in plain English, and the AI handles the rest:
      ingredients, portions, calories and macros, all logged in seconds.
    </p>
    <p>
      No food databases to search, no barcode hunting, no subscriptions.
      NutriNutri is non-profit, open source, and privacy-first: your data
      stays yours, with no analytics and no tracking.
    </p>
  </description>

  <launchable type="desktop-id">sk.popelis.nutrinutri.desktop</launchable>

  <url type="homepage">https://nutrinutri.popelis.sk/</url>
  <url type="bugtracker">https://github.com/riki137/nutrinutri/issues</url>
